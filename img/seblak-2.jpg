<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="100%" height="100%">
  <rect width="600" height="450" fill="#FFE8CC" rx="16"/>
  <!-- Bowl -->
  <ellipse cx="300" cy="270" rx="190" ry="110" fill="#C92A2A" opacity="0.15"/>
  <ellipse cx="300" cy="250" rx="180" ry="100" fill="#1A1A1A"/>
  <ellipse cx="300" cy="245" rx="168" ry="90" fill="#A61E4D"/>
  <!-- Ceker Mercon Art -->
  <g transform="translate(240, 190) rotate(-15)">
    <path d="M 30 70 L 60 20 L 75 25 L 50 75 Z" fill="#E8590C"/>
    <!-- Ceker Jari -->
    <path d="M 60 20 L 50 -10 L 60 -15 L 70 15 Z" fill="#F76707"/>
    <path d="M 70 15 L 85 -5 L 95 0 L 80 20 Z" fill="#F76707"/>
    <path d="M 50 35 L 30 15 L 38 10 L 58 35 Z" fill="#F76707"/>
  </g>
  <g transform="translate(320, 210) rotate(25)">
    <path d="M 30 70 L 60 20 L 75 25 L 50 75 Z" fill="#E8590C"/>
    <path d="M 60 20 L 50 -10 L 60 -15 L 70 15 Z" fill="#F76707"/>
    <path d="M 70 15 L 85 -5 L 95 0 L 80 20 Z" fill="#F76707"/>
  </g>
  <!-- Cabai Mercon Berlimpah -->
  <circle cx="230" cy="250" r="14" fill="#E03131"/>
  <circle cx="370" cy="240" r="16" fill="#C92A2A"/>
  <circle cx="310" cy="270" r="12" fill="#E03131"/>
  <circle cx="270" cy="280" r="10" fill="#FF8787"/>
  <!-- Kerupuk -->
  <ellipse cx="350" cy="265" rx="35" ry="22" fill="#FFE066" stroke="#FAB005" stroke-width="2"/>
  <!-- Uap -->
  <path d="M 270 130 Q 250 90 280 60" stroke="#E03131" stroke-width="5" fill="none" opacity="0.6"/>
  <path d="M 330 120 Q 360 85 320 50" stroke="#E03131" stroke-width="5" fill="none" opacity="0.6"/>
  <!-- Label -->
  <rect x="180" y="380" width="240" height="40" rx="20" fill="#C82333"/>
  <text x="300" y="405" fill="#FFFFFF" font-family="'Plus Jakarta Sans', sans-serif" font-size="16" font-weight="bold" text-anchor="middle">Seblak Ceker Mercon</text>
</svg>
